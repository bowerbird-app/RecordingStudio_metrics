<% content_for :title, @page_copy.fetch(:title) %>
<% page_subtitle = @page_copy.fetch(:subtitle).presence %>
<% content_for(:subtitle, page_subtitle) if page_subtitle %>
<% if @return_anchor_url.present? %>
  <% flat_pack_page_nav(
    round: true,
    style: :default,
    anchor_href: @return_anchor_url,
    anchor_tooltip: t("recording_studio.root_switchable.navigation.close")
  ) %>
<% end %>

<div class="mx-auto flex w-full max-w-3xl flex-col gap-6">
  <% if @available_roots.empty? %>
    <%= render FlatPack::Alert::Component.new(
      style: :info,
      title: @page_copy.fetch(:empty_state_title),
      description: @page_copy.fetch(:empty_state_body)
    ) %>
  <% else %>
    <% persistence_hint = @page_copy.fetch(:persistence_hint).presence %>
    <% if persistence_hint %>
      <p class="text-sm text-(--surface-muted-content-color)"><%= persistence_hint %></p>
    <% end %>

    <%= render FlatPack::Card::Component.new(background: :default, class: "w-full") do |card| %>
      <% card.body do %>
        <%= render FlatPack::List::Component.new(selectable: true, class: "w-full") do %>
          <% @available_roots.each do |root_recording| %>
            <% selected = RecordingStudio::RootSwitchable::RootId.same?(@selected_root&.id, root_recording.id) %>
            <% trailing_content = capture do %>
              <% if selected %>
                <%= render FlatPack::Badge::Component.new(
                  text: @page_copy.fetch(:selected_badge),
                  style: :primary,
                  size: :sm
                ) %>
              <% else %>
                <%= form_with url: root_switch_path(scope: @scope.key), method: :patch, local: true do %>
                  <%= hidden_field_tag "root_switch[root_recording_id]", root_recording.id %>
                  <% if @safe_return_to.present? %>
                    <%= hidden_field_tag "root_switch[return_to]", @safe_return_to %>
                  <% end %>
                  <%= render FlatPack::Button::Component.new(
                    text: @page_copy.fetch(:switch_action_label),
                    style: :default,
                    size: :sm,
                    type: "submit"
                  ) %>
                <% end %>
              <% end %>
            <% end %>

            <%= render FlatPack::List::Item.new(
              hover: true,
              trailing: trailing_content.presence
            ) do %>
              <div class="font-semibold">
                <%= @scope.root_label_for(controller: self, actor: RecordingStudio::RootSwitchable::Current.actor, device_key: current_root_device_key, recording: root_recording) %>
              </div>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
