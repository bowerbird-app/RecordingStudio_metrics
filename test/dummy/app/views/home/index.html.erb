<% dummy_page_nav(title: "Metrics Demo", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Metrics Demo",
    subtitle: "This dummy app is the browser-facing demo surface for RecordingStudioMetrics.",
    variant: :h1
  ) %>

  <div class="grid gap-6 lg:grid-cols-2">
    <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: @workspace ? @workspace.name : "No workspace",
          subtitle: "Workspace-scoped totals from RecordingStudioMetrics.execute.",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>

      <% card.body do %>
        <% if @metrics_error %>
          <p class="text-sm">Metrics could not be calculated for this request.</p>
        <% elsif @member_total %>
          <ul class="space-y-3 text-sm leading-6">
            <li>Members: <%= @member_total.value %></li>
            <li>Active members: <%= @active_members.value %></li>
            <li>Active registrations (status filter): <%= @filtered_active.data.sum { |point| point[:value] } %></li>
            <li>Projects: <%= @project_total.value %></li>
            <li>Projects with images: <%= @projects_with_images.value %></li>
            <li>Average images per project: <%= @average_images.value %></li>
            <li>Site-wide members: <%= @site_member_total.value %></li>
          </ul>
        <% else %>
          <p class="text-sm">Seed a workspace to see metric results.</p>
        <% end %>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "Registrations",
          subtitle: "Monthly member creation counts for the current workspace.",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>

      <% card.body do %>
        <% if @registrations %>
          <ul class="space-y-3 text-sm leading-6">
            <% @registrations.data.each do |point| %>
              <li><%= point[:date] %>: <%= point[:value] %></li>
            <% end %>
          </ul>
        <% else %>
          <p class="text-sm">No time-series data.</p>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
